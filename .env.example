# URL publica do projeto Supabase.
NEXT_PUBLIC_SUPABASE_URL=

# O nome ANON_KEY foi preservado por compatibilidade, mas o valor deve ser
# exclusivamente uma chave Publishable moderna (sb_publishable_).
# Chaves Secret/service_role nunca podem usar o prefixo NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Nunca exponha esta chave no navegador; necessária apenas no servidor para convites.
SUPABASE_SERVICE_ROLE_KEY=

# Origem canônica usada para links de convite (sem valor real neste arquivo).
NEXT_PUBLIC_SITE_URL=

# Chave server-only usada pela camada opcional de respostas OpenAI.
OPENAI_API_KEY=

# Chave server-only que protege a API interna da UCE.
UCE_API_KEY=

# URL usada apenas pelo script local de teste da API UCE.
UCE_API_URL=

# Segredo server-only usado para validar assinaturas HMAC do endpoint de Leads n8n.
N8N_LEADS_SIGNING_SECRET=
